# Copie este arquivo para ".env" e preencha com os valores do SEU projeto Supabase.
# NUNCA coloque valores reais neste arquivo (.env.example) nem faça commit do .env real.
# Use somente a chave "anon/public" aqui — a "service_role" nunca pode ir para o frontend.

VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anon-publica-aqui
